ADMIN_PASSWORD_HASH=
COOKIE_SECRET=
PORT=3001
# Optional. Pins the origin used for og:url/og:image in the Open Graph
# preview served to link-preview crawlers (Twitter/Facebook/Slack/Discord)
# to a trusted value, instead of trusting the request's own Host header.
# Format: scheme://host[:port], no trailing slash. Leave unset to fall back
# to the request-derived origin (fine for most deployments — see CLAUDE.md
# gotcha on issue #53 for why this exists).
# PUBLIC_ORIGIN=https://podcast.example.com
