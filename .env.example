ADMIN_PASSWORD_HASH=
COOKIE_SECRET=
PORT=3001
# Optional. Pins the origin used for og:url/og:image in the Open Graph
# preview served to link-preview crawlers (Twitter/Facebook/Slack/Discord)
# to a trusted value, instead of trusting the request's own Host header.
# Format: scheme://host[:port], no trailing slash. Leave unset to fall back
# to the request-derived origin (fine for most deployments — see CLAUDE.md
# gotcha on issue #53 for why this exists).
# PUBLIC_ORIGIN=https://podcast.example.com

# Optional. Comma-separated IPs Fastify trusts to set X-Forwarded-For
# (i.e. your reverse proxy's address, as seen from inside the app's own
# network namespace — NOT necessarily its loopback address if the app runs
# in a container behind a host-level proxy; see CLAUDE.md gotcha on issue
# #33 for why that distinction matters). Leave unset to trust loopback only
# (127.0.0.1,::1), which is correct if there's no reverse proxy in front of
# the app at all.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional. Path to a local GeoIP .mmdb database, used to resolve listener
# country for the analytics dashboard's geography breakdown. Analytics work
# fully without this — the country breakdown just stays empty. Populate the
# file with `scripts/fetch-geoip-db.sh [path]` (see README's Analytics
# section), then point this at wherever it wrote the file. If you're running
# via docker-compose with the default ./data:/app/data mount, the
# conventional path is /app/data/geoip/dbip-country-lite.mmdb.
# GEOIP_DB_PATH=/app/data/geoip/dbip-country-lite.mmdb
